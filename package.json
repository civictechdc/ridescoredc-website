{
  "name": "ridescoredc-website",
  "private": true,
  "type": "module",
  "scripts": {
    "check-env": "node scripts/check-env.mjs",
    "dev": "vite",
    "stack": "node scripts/check-env.mjs && docker compose up",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "restart": "docker compose restart",
    "data": "uv run scripts/load_data.py",
    "migrate": "uv run scripts/migrate.py",
    "migrate:list": "uv run scripts/migrate.py --list",
    "setup": "npm run data && npm run migrate"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
