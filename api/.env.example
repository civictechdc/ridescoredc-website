# Copy to .env (gitignored):  cp api/.env.example api/.env
# Read by Docker Compose locally (via env_file in docker-compose.yml) and by the
# app on the server (exported / loaded as a systemd EnvironmentFile).

# Postgres superuser password — used by the db container.
POSTGRES_PASSWORD=localdev

# Connection string the app and Martin use.
# Local Docker Compose: the host is the compose service name "db".
DATABASE_URL=postgres://postgres:localdev@db/db
# On a bare-metal server (uvicorn/gunicorn without Compose), point it at that
# host's Postgres instead, e.g. postgres://postgres:PASSWORD@localhost/db

# The login for the comment review page (/admin/). Anyone with it can approve
# comments for the public map. admin / password is for running the stack on
# your own machine; on a server, choose a real password.
# Left without a password, comment review is switched off and the page cannot
# be used.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
