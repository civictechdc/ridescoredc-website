# Copy to .env.local, which is never committed:  cp .env.example .env.local
#
# Where `npm run dev` sends the requests it does not answer itself: the map
# tiles and the feedback API. The pages themselves always come from your own
# working folder.

# The shared development server. Nothing else needs to be running.
VITE_UPSTREAM=https://dev.ridescoredc.com

# Your own stack instead, once `docker compose up` is running:
# VITE_UPSTREAM=http://localhost:8000
