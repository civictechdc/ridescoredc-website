# Martin's configuration on a server, where it runs as a system service rather
# than a container. The Compose stack uses martin.yaml in the repository root;
# this is the deployed equivalent of the same decision.
#
# Copy to /etc/martin/config.yaml, put the real connection string in, and point
# the unit at it:
#
#   ExecStart=/usr/bin/martin --config /etc/martin/config.yaml
#
# The file then holds the database password, so keep it away from other accounts:
#
#   sudo chown root:<the user martin runs as> /etc/martin/config.yaml
#   sudo chmod 640 /etc/martin/config.yaml
#
# Putting the connection string here rather than on the ExecStart line also
# keeps it out of the unit file, which every account on the machine can read.
#
# ── Why the schema list matters ────────────────────────────────────────────────
#
# Martin published every schema it could see until this file existed. Left that
# way it publishes data.road_segment, data.crashes and data.ridescore_v1_scores
# as well -- every column, on the open internet, scores included.
#
# The survey depends on that not happening. A respondent is asked how safe a
# street feels, and must not be shown our assessment of it first. The guarantee
# is serving.survey_segments naming four columns and no score -- but a guarantee
# about one view is worth nothing if the data schema is publishable beside it.
#
# So: serving, and only serving. The road data stays where only serving can
# reach it.

# ── Why auto_bounds is skip ───────────────────────────────────────────────────
#
# Martin works out once, at startup, the area each source's rows cover, and
# answers every tile outside it with nothing. serving.rider_hazard grows as
# people answer the survey, so a street rated for the first time outside that
# area would stay off the map until the next restart. Skipping the calculation
# serves every source everywhere; the cost is a query for tiles outside DC that
# would have been refused without one.

postgres:
  connection_string: postgresql://USER:PASSWORD@localhost:5432/db
  auto_bounds: skip
  auto_publish:
    tables:
      from_schemas:
        - serving
    functions:
      from_schemas:
        - serving

# ── Why there is no tile cache ────────────────────────────────────────────────
#
# Martin keeps a cached tile until it restarts, and this version can neither
# expire tiles nor leave one source out of the cache. serving.rider_hazard
# changes with every survey response, so a cached tile would hide new ratings
# until the next deploy. Every tile is built from the database instead; the
# road network is small and indexed, so that is cheap.

# cache_size_mb rather than tile_cache_size_mb: this version ignores the
# latter unless the former is also set. It turns off Martin's other caches
# too, which hold fonts, sprites and PMTiles, none of which this site uses.
cache_size_mb: 0
